# =============================================================================
# Workspace Monitor — Root Environment Variables
# =============================================================================
# Used by docker-compose. Copy to .env and update values.
# =============================================================================

# PostgreSQL
POSTGRES_USER=workspace_user
POSTGRES_PASSWORD=workspace_pass_dev
POSTGRES_DB=workspace_monitor
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
APP_NAME=WorkspaceMonitor
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:5173/auth/callback
YOLO_MODEL_PATH=yolo26n.pt
CONFIDENCE_THRESHOLD=0.5
FRAME_SKIP_INTERVAL=5

# Frontend
VITE_API_BASE_URL=http://localhost:8000
