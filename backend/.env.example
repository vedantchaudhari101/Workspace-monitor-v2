# =============================================================================
# Workspace Monitor — Backend environment (copy to backend/.env)
# =============================================================================

# Application
APP_NAME=WorkspaceMonitor
APP_VERSION=2.0.0
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database — SQLite by default; set USE_SQLITE=false for PostgreSQL
USE_SQLITE=true
SQLITE_PATH=workspace_monitor.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=workspace_user
POSTGRES_PASSWORD=workspace_pass_dev
POSTGRES_DB=workspace_monitor

# Authentication
SECRET_KEY=change-me-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Created on first start when no users exist
ADMIN_EMAIL=admin@workspace.dev
ADMIN_PASSWORD=Admin@12345

# Computer vision
CV_PIPELINE=report            # report | legacy
YOLO_MODEL_PATH=yolov8n.pt    # chair calibration (downloaded automatically if missing)
POSE_MODEL_PATH=yolov8n-pose.pt
CALIBRATION_FRAMES=150
CALIBRATION_SKIP=3
OCC_FRAMES=15
CLEAR_FRAMES=10
VELOCITY_GATE_PX=32
HIP_WEIGHT=0.70
CROSS_EXPAND=0.30
SEAT_MATCH_IOU=0.30
FRAME_SKIP_INTERVAL=5         # legacy pipeline only

# Uploads and runtime
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500
DEMO_MODE=false               # true = simulate seeded cameras and include demo data by default
SHOW_DEMO_LOGIN=false         # true = sign-in page offers the admin account (public showcases only)
SAMPLE_VIDEO_PATH=            # optional video visitors can analyse with one click
SAMPLE_VIDEO_CREDIT=
FRONTEND_DIST=                # path to frontend/dist to serve the web app from the API
RUN_MIGRATIONS=true
